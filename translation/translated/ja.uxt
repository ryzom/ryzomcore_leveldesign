uihelpPhraseCrystalSpellFormat	[@{FFFF}--- 付呪 ---\n@{FFF9}このアイテムを使うと、武器に次のアクションを付呪できます：\n@{FFF9}コスト：@{T14}@{FFFF}%cost\n@{FFF9}クレジット：@{T14}@{FFFF}%credit\n\n@{FFF9}付呪されたアイテムのアクションは必ず成功します。\n@{FFF9}詠唱時間：@{T16}@{FFFF}%duration秒\n@{FFF9}樹液消費：@{T16}@{FFFF}%energy_cost\n@{FFF9}HP消費：@{T16}@{FFFF}%hp_cost\n@{FFF9}射程：@{T16}@{FFFF}%range\n]

// HASH_VALUE D143C452681C513F
// INDEX 2528
uihelpPhraseRequirementHeader	[\n@{FFFF}--- 必要条件 ---\n@{FFF9}@{HuittActionSkillPoint}スキルポイント：@{H}@{T16}@{FFFF}%sp/%basesp\n@{FFF9}@{HuittActionSkillReq}必要スキル：@{H}\n]

