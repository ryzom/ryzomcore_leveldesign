        <CHILD TYPE="CPrimNode">
          <PROPERTY TYPE="string">
            <NAME>class</NAME>
            <STRING>linear_dyn_chat_fail</STRING>
          </PROPERTY>
          <PROPERTY TYPE="string">
            <NAME>name</NAME>
            <STRING>offer</STRING>
          </PROPERTY>
          <PROPERTY TYPE="string">
            <NAME>npc_name</NAME>
            <STRING>$givervar$</STRING>
          </PROPERTY>
          <PROPERTY TYPE="string_array">
            <NAME>phrase</NAME>
            <STRING>"Every homin who lands on this island carries something. Tools, a blade, a grudge. What do you carry, $player$?{break}Our people fled the old lands with next to nothing. But we kept our tales. Tales weigh nothing, and they feed many.{break}There is one about Loria, our great heroine, when she was only a slip of a girl. $noeh$'s troupe plays it here.{break}Go and greet $noeh$ at the stage on the sand, just outside the village. Say the Sage sent you." OFFER</STRING>
          </PROPERTY>
          <PROPERTY TYPE="string_array">
            <NAME>phrase_yes</NAME>
            <STRING>"I'll go and meet the troupe." ACCEPT</STRING>
          </PROPERTY>
        </CHILD>
