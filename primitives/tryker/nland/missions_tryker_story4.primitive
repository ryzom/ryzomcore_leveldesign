          <PROPERTY TYPE="string">
            <NAME>npc_name</NAME>
            <STRING>$givervar$</STRING>
          </PROPERTY>
          <PROPERTY TYPE="string_array">
            <NAME>phrase</NAME>
            <STRING>"Hoy, $player$. See those yubos out on the grass? Fat, slow, and not a care on Atys.{break}In the tale, little Loria skipped after yubos all day long. Never caught one, if you ask me.{break}You will have to do better. On stage, an elder wears a string of yubo teeth, and our strings keep snapping.{break}Take this dagger. Bring a yubo down, then quarter it: target the body and take what it gives.{break}I need $tooth_qt$ $tooth.p$. And if anything bigger than a yubo looks at you twice, run. There's no shame in it." OFFER</STRING>
          </PROPERTY>
          <PROPERTY TYPE="string_array">
            <NAME>phrase_yes</NAME>
            <STRING>"I'll skip faster than Loria did." ACCEPT</STRING>
          </PROPERTY>
        </CHILD>
