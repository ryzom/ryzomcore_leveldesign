            <CHILD TYPE="CPrimNode">
              <PROPERTY TYPE="string">
                <NAME>class</NAME>
                <STRING>remove_compass</STRING>
              </PROPERTY>
              <PROPERTY TYPE="string">
                <NAME>npc_to_remove</NAME>
                <STRING>$noeh$</STRING>
              </PROPERTY>
            </CHILD>
            <CHILD TYPE="CPrimNode">
              <PROPERTY TYPE="string">
                <NAME>class</NAME>
                <STRING>bot_chat</STRING>
              </PROPERTY>
              <PROPERTY TYPE="string">
                <NAME>npc_name</NAME>
                <STRING>$noeh$</STRING>
              </PROPERTY>
              <PROPERTY TYPE="string_array">
                <NAME>phrase</NAME>
                <STRING>"An audience! At last! Sit down, sit... no. No, wait. We cannot play. Look at the state of us!{break}Our Loria has no pebbles left for her pocket. The elders have lost their teeth. And her boots! Don't ask about her boots.{break}Custom says a homin lends a hand to the community before the tale is told. Three of mine could use your hands.{break}$beach$ is down on the shore, $hunter$ watches the yubo meadow, and $wardrobe$ keeps the costume chest in the village. Help them in any order you please.{break}When all three are content, go back to the Sage. He will send you to me, and you shall have the best seat on the sand!" NOEH</STRING>
              </PROPERTY>
            </CHILD>
            <CHILD TYPE="CPrimNode">
              <PROPERTY TYPE="string">
